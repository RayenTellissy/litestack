diff --git a/tasks/store.py b/tasks/store.py
index b725981..54a1177 100644
--- a/tasks/store.py
+++ b/tasks/store.py
@@ -1,6 +1,7 @@
 import json
 import os
 from dataclasses import asdict
+from datetime import date
 
 from .model import Task
 
@@ -12,11 +13,26 @@ def path():
 def load():
     try:
         with open(path()) as f:
-            return [Task(**raw) for raw in json.load(f)]
+            return [_decode(raw) for raw in json.load(f)]
     except FileNotFoundError:
         return []
 
 
 def save(tasks):
     with open(path(), "w") as f:
-        json.dump([asdict(task) for task in tasks], f, indent=2)
+        json.dump([_encode(task) for task in tasks], f, indent=2)
+
+
+def _decode(raw):
+    if raw.get("due") is not None:
+        raw = {**raw, "due": date.fromisoformat(raw["due"])}
+    return Task(**raw)
+
+
+def _encode(task):
+    raw = asdict(task)
+    if task.due is None:
+        del raw["due"]
+    else:
+        raw["due"] = task.due.isoformat()
+    return raw
