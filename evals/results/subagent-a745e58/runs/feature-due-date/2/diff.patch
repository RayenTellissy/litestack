 import json
 import os
 from dataclasses import asdict
+from datetime import date
 
 from .model import Task
 
@@ -12,11 +13,25 @@ def path():
 def load():
     try:
         with open(path()) as f:
-            return [Task(**raw) for raw in json.load(f)]
+            return [_from_json(raw) for raw in json.load(f)]
     except FileNotFoundError:
         return []
 
 
 def save(tasks):
     with open(path(), "w") as f:
-        json.dump([asdict(task) for task in tasks], f, indent=2)
+        json.dump([_to_json(task) for task in tasks], f, indent=2)
+
+
+def _from_json(raw):
+    due = raw.pop("due", None)
+    return Task(**raw, due=None if due is None else date.fromisoformat(due))
+
+
+def _to_json(task):
+    raw = asdict(task)
+    due = raw.pop("due")
+    # Undated tasks keep the old file shape, which versions without due dates can still load.
+    if due is not None:
+        raw["due"] = due.isoformat()
+    return raw
