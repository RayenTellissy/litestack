+    def test_add_with_due_date_then_list(self):
+        self.run_cli("add", "Buy milk", "--tag", "home", "--due", "2026-11-01")
+        self.run_cli("add", "File taxes")
+        out = self.run_cli("list").stdout
+        self.assertEqual(out, "[ ] 1 Buy milk #home due 2026-11-01\n[ ] 2 File taxes\n")
+
+    def test_invalid_due_date_is_rejected_and_not_stored(self):
+        self.run_cli("add", "Buy milk", "--due", "2026-11-01")
+        for value in ("2026-02-30", "20261101", "tomorrow"):
+            result = self.run_cli("add", "Pay rent", "--due", value)
+            self.assertEqual(result.returncode, 2, value)
+            self.assertIn(f"'{value}'", result.stderr)
+            self.assertEqual(result.stdout, "", value)
+        self.assertEqual(self.run_cli("list").stdout, "[ ] 1 Buy milk due 2026-11-01\n")
+
+    def test_list_overdue(self):
+        today = date.today()
+        yesterday = (today - timedelta(days=1)).isoformat()
+        tomorrow = (today + timedelta(days=1)).isoformat()
+        self.run_cli("add", "Late", "--due", yesterday)
+        self.run_cli("add", "Due today", "--due", today.isoformat())
+        self.run_cli("add", "Not yet", "--due", tomorrow)
+        self.run_cli("add", "Someday")
+        self.run_cli("add", "Late but done", "--due", yesterday)
+        self.run_cli("done", "5")
+        self.assertEqual(self.run_cli("list", "--overdue").stdout, f"[ ] 1 Late due {yesterday}\n")
+
+    def test_list_overdue_without_matches(self):
+        self.run_cli("add", "Someday")
+        self.run_cli("add", "Not yet", "--due", "2999-01-01")
+        self.assertEqual(self.run_cli("list", "--overdue").stdout, "No tasks.\n")
+
+    def test_loads_task_file_written_before_due_dates(self):
+        with open(self.env["TASKS_FILE"], "w") as f:
+            json.dump([{"id": 1, "title": "Buy milk", "done": False, "tags": ["home"]}], f)
+        self.assertEqual(self.run_cli("list").stdout, "[ ] 1 Buy milk #home\n")
+        self.run_cli("add", "File taxes")
+        self.run_cli("done", "1")
+        self.assertEqual(self.run_cli("list", "--all").stdout, "[x] 1 Buy milk #home\n[ ] 2 File taxes\n")
+
 
 if __name__ == "__main__":
     unittest.main()
