diff --git a/tests/test_cli.py b/tests/test_cli.py
index 7b56bad..fecc4d2 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -41,6 +41,31 @@ class CliTest(unittest.TestCase):
         self.assertEqual(result.returncode, 1)
         self.assertEqual(result.stderr, "No task 9.\n")
 
+    def test_search_ignores_case(self):
+        self.run_cli("add", "Buy milk", "--tag", "home")
+        self.run_cli("add", "File taxes")
+        self.run_cli("add", "Milk the cow")
+        result = self.run_cli("search", "MILK")
+        self.assertEqual(result.returncode, 0)
+        self.assertEqual(result.stdout, "[ ] 1 Buy milk #home\n[ ] 3 Milk the cow\n")
+
+    def test_search_hides_done_unless_all(self):
+        self.run_cli("add", "Buy milk")
+        self.run_cli("add", "Buy bread")
+        self.run_cli("done", "1")
+        self.assertEqual(self.run_cli("search", "buy").stdout, "[ ] 2 Buy bread\n")
+        self.assertEqual(
+            self.run_cli("search", "buy", "--all").stdout,
+            "[x] 1 Buy milk\n[ ] 2 Buy bread\n",
+        )
+
+    def test_search_no_match(self):
+        self.run_cli("add", "Buy milk")
+        self.run_cli("done", "1")
+        for args in (["milk"], ["taxes", "--all"]):
+            result = self.run_cli("search", *args)
+            self.assertEqual((result.returncode, result.stdout), (1, "No matching tasks.\n"), args)
+
 
 if __name__ == "__main__":
     unittest.main()
