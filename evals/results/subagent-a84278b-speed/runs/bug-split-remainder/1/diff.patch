         self.assertEqual(allocate(9000, 3), [3000, 3000, 3000])
 
+    def test_shares_add_up_to_total(self):
+        for total in range(-1000, 1001):
+            for parts in range(1, 13):
+                shares = allocate(total, parts)
+                self.assertEqual(len(shares), parts, (total, parts))
+                self.assertEqual(sum(shares), total, (total, parts))
+                self.assertLessEqual(max(shares) - min(shares), 1, (total, parts))
+
     def test_rejects_zero_parts(self):
         with self.assertRaises(ValueError):
             allocate(100, 0)
