@@ -26,6 +26,17 @@ class AllocateTest(unittest.TestCase):
     def test_even_split(self):
         self.assertEqual(allocate(9000, 3), [3000, 3000, 3000])
 
+    def test_uneven_split_gives_leftover_cents_to_first_parts(self):
+        self.assertEqual(allocate(10000, 3), [3334, 3333, 3333])
+
+    def test_shares_add_up_to_total(self):
+        for total in range(0, 1001):
+            for parts in range(1, 8):
+                with self.subTest(total=total, parts=parts):
+                    shares = allocate(total, parts)
+                    self.assertEqual(sum(shares), total)
+                    self.assertLessEqual(max(shares) - min(shares), 1)
+
     def test_rejects_zero_parts(self):
         with self.assertRaises(ValueError):
             allocate(100, 0)
