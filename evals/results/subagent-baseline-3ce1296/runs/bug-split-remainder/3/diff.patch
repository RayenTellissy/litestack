+    def test_shares_sum_to_total_and_differ_by_at_most_a_cent(self):
+        for total in (-101, -1, 0, 1, 2, 5, 100, 10000, 10001):
+            for parts in range(1, 8):
+                with self.subTest(total=total, parts=parts):
+                    shares = allocate(total, parts)
+                    self.assertEqual(len(shares), parts)
+                    self.assertEqual(sum(shares), total)
+                    self.assertLessEqual(max(shares) - min(shares), 1)
+
     def test_rejects_zero_parts(self):
         with self.assertRaises(ValueError):
             allocate(100, 0)
