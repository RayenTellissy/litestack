+    def test_search_matches_title_ignoring_case(self):
+        self.run_cli("add", "Buy milk", "--tag", "home")
+        self.run_cli("add", "File taxes")
+        self.run_cli("add", "buy BREAD")
+        result = self.run_cli("search", "BUY")
+        self.assertEqual(result.returncode, 0)
+        self.assertEqual(result.stdout, "[ ] 1 Buy milk #home\n[ ] 3 buy BREAD\n")
+
+    def test_search_hides_done_unless_all(self):
+        self.run_cli("add", "Buy milk")
+        self.run_cli("add", "Buy bread")
+        self.run_cli("done", "1")
+        self.assertEqual(self.run_cli("search", "buy").stdout, "[ ] 2 Buy bread\n")
+        result = self.run_cli("search", "buy", "--all")
+        self.assertEqual(result.returncode, 0)
+        self.assertEqual(result.stdout, "[x] 1 Buy milk\n[ ] 2 Buy bread\n")
+
+    def test_search_no_match(self):
+        self.run_cli("add", "Buy milk", "--tag", "home")
+        result = self.run_cli("search", "home")
+        self.assertEqual(result.returncode, 1)
+        self.assertEqual(result.stdout, "No matching tasks.\n")
+
 
 if __name__ == "__main__":
