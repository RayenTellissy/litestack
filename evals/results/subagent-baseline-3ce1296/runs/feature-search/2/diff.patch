@@ -41,6 +41,41 @@ class CliTest(unittest.TestCase):
         self.assertEqual(result.returncode, 1)
         self.assertEqual(result.stderr, "No task 9.\n")
 
+    def test_search_ignores_case(self):
+        self.run_cli("add", "Buy milk", "--tag", "home")
+        self.run_cli("add", "File taxes")
+        self.run_cli("add", "Oat Milk")
+        result = self.run_cli("search", "MILK")
+        self.assertEqual(result.returncode, 0)
+        self.assertEqual(result.stdout, "[ ] 1 Buy milk #home\n[ ] 3 Oat Milk\n")
+
+    def test_search_hides_done_unless_all(self):
+        self.run_cli("add", "Buy milk")
+        self.run_cli("add", "Oat milk")
+        self.run_cli("done", "1")
+        self.assertEqual(self.run_cli("search", "milk").stdout, "[ ] 2 Oat milk\n")
+        self.assertEqual(self.run_cli("search", "milk", "--all").stdout, "[x] 1 Buy milk\n[ ] 2 Oat milk\n")
+
+    def test_search_no_match(self):
+        self.run_cli("add", "Buy milk")
+        result = self.run_cli("search", "eggs")
+        self.assertEqual(result.returncode, 1)
+        self.assertEqual(result.stdout, "")
+        self.assertEqual(result.stderr, "No matching tasks.\n")
+
+    def test_search_ignores_tags(self):
+        self.run_cli("add", "Buy milk", "--tag", "home")
+        result = self.run_cli("search", "home")
+        self.assertEqual(result.returncode, 1)
+        self.assertEqual(result.stderr, "No matching tasks.\n")
+
+    def test_search_only_done_match_without_all(self):
+        self.run_cli("add", "Buy milk")
+        self.run_cli("done", "1")
+        result = self.run_cli("search", "milk")
+        self.assertEqual(result.returncode, 1)
+        self.assertEqual(result.stderr, "No matching tasks.\n")
+
 
 if __name__ == "__main__":
     unittest.main()
