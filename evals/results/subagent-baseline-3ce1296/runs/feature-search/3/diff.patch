diff --git a/tasks/cli.py b/tasks/cli.py
index 9f5650f..7f850da 100644
--- a/tasks/cli.py
+++ b/tasks/cli.py
@@ -39,6 +39,20 @@ def cmd_done(args):
     return 1
 
 
+def cmd_search(args):
+    needle = args.text.casefold()
+    tasks = [
+        t for t in store.load()
+        if (args.all or not t.done) and needle in t.title.casefold()
+    ]
+    if not tasks:
+        print("No matching tasks.", file=sys.stderr)
+        return 1
+    for task in tasks:
+        print(task.line())
+    return 0
+
+
 def parser():
     p = argparse.ArgumentParser(prog="tasks")
     sub = p.add_subparsers(dest="command", required=True)
@@ -56,6 +70,11 @@ def parser():
     done = sub.add_parser("done", help="mark a task done")
     done.add_argument("id", type=int)
     done.set_defaults(run=cmd_done)
+
+    search = sub.add_parser("search", help="list open tasks whose title contains text")
+    search.add_argument("text")
+    search.add_argument("--all", action="store_true", help="include done tasks")
+    search.set_defaults(run=cmd_search)
     return p
 
 
diff --git a/tests/test_cli.py b/tests/test_cli.py
index 7b56bad..6338243 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -41,6 +41,45 @@ class CliTest(unittest.TestCase):
         self.assertEqual(result.returncode, 1)
         self.assertEqual(result.stderr, "No task 9.\n")
 
+    def test_search_matches_title_ignoring_case(self):
+        self.run_cli("add", "Buy Milk", "--tag", "home")
+        self.run_cli("add", "File taxes")
+        self.run_cli("add", "milkshake recipe")
+        result = self.run_cli("search", "mILK")
+        self.assertEqual(result.returncode, 0)
+        self.assertEqual(result.stdout, "[ ] 1 Buy Milk #home\n[ ] 3 milkshake recipe\n")
+        self.assertEqual(result.stderr, "")
+
+    def test_search_hides_done_tasks_unless_all(self):
+        self.run_cli("add", "Buy milk")
+        self.run_cli("add", "Oat milk")
+        self.run_cli("done", "1")
+        self.assertEqual(self.run_cli("search", "milk").stdout, "[ ] 2 Oat milk\n")
+        result = self.run_cli("search", "milk", "--all")
+        self.assertEqual(result.returncode, 0)
+        self.assertEqual(result.stdout, "[x] 1 Buy milk\n[ ] 2 Oat milk\n")
+
+    def test_search_no_match(self):
+        self.run_cli("add", "Buy milk", "--tag", "bread")
+        result = self.run_cli("search", "bread")
+        self.assertEqual(result.returncode, 1)
+        self.assertEqual(result.stdout, "")
+        self.assertEqual(result.stderr, "No matching tasks.\n")
+
+    def test_search_done_match_without_all(self):
+        self.run_cli("add", "Buy milk")
+        self.run_cli("done", "1")
+        result = self.run_cli("search", "milk")
+        self.assertEqual(result.returncode, 1)
+        self.assertEqual(result.stdout, "")
+        self.assertEqual(result.stderr, "No matching tasks.\n")
+
+    def test_search_empty_store(self):
+        result = self.run_cli("search", "milk")
+        self.assertEqual(result.returncode, 1)
+        self.assertEqual(result.stderr, "No matching tasks.\n")
+        self.assertFalse(os.path.exists(self.env["TASKS_FILE"]))
+
 
 if __name__ == "__main__":
     unittest.main()
