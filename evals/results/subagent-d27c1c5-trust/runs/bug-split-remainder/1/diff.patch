@@ -20,5 +20,5 @@ def format_amount(cents):
 def allocate(total_cents, parts):
     if parts <= 0:
         raise ValueError("parts must be positive")
-    share = total_cents // parts
-    return [share] * parts
+    share, extra = divmod(total_cents, parts)
+    return [share + 1] * extra + [share] * (parts - extra)
