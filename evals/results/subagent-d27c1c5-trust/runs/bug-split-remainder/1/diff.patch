@@ -26,6 +26,14 @@ class AllocateTest(unittest.TestCase):
     def test_even_split(self):
         self.assertEqual(allocate(9000, 3), [3000, 3000, 3000])
 
+    def test_shares_always_add_up_to_total(self):
+        for total in range(-1000, 3001):
+            for parts in range(1, 13):
+                shares = allocate(total, parts)
+                case = f"allocate({total}, {parts}) -> {shares}"
+                self.assertEqual(sum(shares), total, case)
+                self.assertLessEqual(max(shares) - min(shares), 1, case)
+
     def test_rejects_zero_parts(self):
         with self.assertRaises(ValueError):
             allocate(100, 0)
