         self.assertEqual(result.stderr, "No task 9.\n")
 
 
+    def test_add_with_due_then_list(self):
+        self.run_cli("add", "Buy milk", "--tag", "home", "--due", "2026-11-01")
+        self.run_cli("add", "File taxes")
+        out = self.run_cli("list").stdout
+        self.assertEqual(out, "[ ] 1 Buy milk #home due 2026-11-01\n[ ] 2 File taxes\n")
+
+    def test_list_overdue(self):
+        today = date.today()
+        yesterday = (today - timedelta(days=1)).isoformat()
+        self.run_cli("add", "Past", "--due", yesterday)
+        self.run_cli("add", "Today", "--due", today.isoformat())
+        self.run_cli("add", "Future", "--due", (today + timedelta(days=1)).isoformat())
+        self.run_cli("add", "Undated")
+        self.run_cli("add", "Done past", "--due", yesterday)
+        self.run_cli("done", "5")
+        expected = f"[ ] 1 Past due {yesterday}\n"
+        self.assertEqual(self.run_cli("list", "--overdue").stdout, expected)
+        self.assertEqual(self.run_cli("list", "--overdue", "--all").stdout, expected)
+
+    def test_list_overdue_when_none(self):
+        self.run_cli("add", "Future", "--due", "2999-01-01")
+        self.assertEqual(self.run_cli("list", "--overdue").stdout, "No tasks.\n")
+
+    def test_add_rejects_invalid_due(self):
+        self.run_cli("add", "Buy milk", "--due", "2026-02-28")
+        result = self.run_cli("add", "Ski trip", "--due", "2026-02-30")
+        self.assertEqual(result.returncode, 2)
+        self.assertIn("2026-02-30", result.stderr)
+        self.assertEqual(result.stdout, "")
+        self.assertEqual(self.run_cli("list").stdout, "[ ] 1 Buy milk due 2026-02-28\n")
+
+    def test_loads_file_written_before_due_dates(self):
+        old = {"id": 1, "title": "Buy milk", "done": False, "tags": ["home"]}
+        with open(self.env["TASKS_FILE"], "w") as f:
+            json.dump([old], f)
+        self.run_cli("add", "File taxes", "--due", "2026-11-01")
+        out = self.run_cli("list").stdout
+        self.assertEqual(out, "[ ] 1 Buy milk #home\n[ ] 2 File taxes due 2026-11-01\n")
+        with open(self.env["TASKS_FILE"]) as f:
+            self.assertEqual(json.load(f)[0], old)
+
 if __name__ == "__main__":
     unittest.main()
