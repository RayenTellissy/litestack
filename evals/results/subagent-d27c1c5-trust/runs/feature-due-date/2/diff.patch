diff --git a/tasks/store.py b/tasks/store.py
index b725981..7b9b4b8 100644
--- a/tasks/store.py
+++ b/tasks/store.py
@@ -1,6 +1,7 @@
 import json
 import os
 from dataclasses import asdict
+from datetime import date
 
 from .model import Task
 
@@ -12,11 +13,24 @@ def path():
 def load():
     try:
         with open(path()) as f:
-            return [Task(**raw) for raw in json.load(f)]
+            return [_from_record(raw) for raw in json.load(f)]
     except FileNotFoundError:
         return []
 
 
 def save(tasks):
     with open(path(), "w") as f:
-        json.dump([asdict(task) for task in tasks], f, indent=2)
+        json.dump([_to_record(task) for task in tasks], f, indent=2)
+
+
+def _from_record(raw):
+    due = raw.get("due")
+    return Task(**{**raw, "due": None if due is None else date.fromisoformat(due)})
+
+
+def _to_record(task):
+    record = asdict(task)
+    due = record.pop("due")
+    if due is not None:
+        record["due"] = due.isoformat()
+    return record
