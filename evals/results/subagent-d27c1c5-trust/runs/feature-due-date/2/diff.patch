+
+    def test_list_overdue(self):
+        self.run_cli("add", "Pay rent", "--due", "2000-01-01")
+        self.run_cli("add", "Call mom", "--due", date.today().isoformat())
+        self.run_cli("add", "Renew passport", "--due", "2999-12-31")
+        self.run_cli("add", "Buy milk")
+        self.run_cli("add", "Return books", "--due", "2000-01-02")
+        self.run_cli("done", "5")
+        expected = "[ ] 1 Pay rent due 2000-01-01\n"
