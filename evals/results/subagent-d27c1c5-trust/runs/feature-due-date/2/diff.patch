+    # From Python 3.11, fromisoformat also accepts forms such as 20261101 and 2026-W44-4.
+    if due is None or due.isoformat() != value:
+        raise argparse.ArgumentTypeError(f"invalid date {value!r}, expected YYYY-MM-DD")
+    return due
