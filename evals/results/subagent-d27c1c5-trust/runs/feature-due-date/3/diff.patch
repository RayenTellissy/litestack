+    def test_add_with_due_then_list(self):
+        self.run_cli("add", "Buy milk", "--tag", "home", "--due", "2026-11-01")
+        self.run_cli("add", "File taxes")
+        out = self.run_cli("list").stdout
+        self.assertEqual(out, "[ ] 1 Buy milk #home due 2026-11-01\n[ ] 2 File taxes\n")
+
+    def test_due_survives_done(self):
+        self.run_cli("add", "Buy milk", "--due", "2026-11-01")
+        self.run_cli("done", "1")
+        self.assertEqual(self.run_cli("list", "--all").stdout, "[x] 1 Buy milk due 2026-11-01\n")
+
+    def test_list_overdue(self):
+        today = date.today()
+        yesterday, tomorrow = today - timedelta(days=1), today + timedelta(days=1)
+        self.run_cli("add", "Late", "--due", yesterday.isoformat())
+        self.run_cli("add", "Today", "--due", today.isoformat())
+        self.run_cli("add", "Soon", "--due", tomorrow.isoformat())
+        self.run_cli("add", "Someday")
+        self.run_cli("add", "Finished", "--due", yesterday.isoformat())
+        self.run_cli("done", "5")
+        self.assertEqual(self.run_cli("list", "--overdue").stdout, f"[ ] 1 Late due {yesterday}\n")
+
+    def test_list_overdue_none(self):
+        self.run_cli("add", "Soon", "--due", (date.today() + timedelta(days=1)).isoformat())
+        self.assertEqual(self.run_cli("list", "--overdue").stdout, "No tasks.\n")
+
+    def test_add_invalid_due(self):
+        self.run_cli("add", "Buy milk")
+        for value in ("2026-02-30", "soon"):
+            with self.subTest(value=value):
+                result = self.run_cli("add", "File taxes", "--due", value)
+                self.assertEqual(result.returncode, 2)
+                self.assertEqual(
+                    result.stderr.splitlines()[-1],
+                    f"tasks add: error: argument --due: invalid date '{value}', expected YYYY-MM-DD",
+                )
+        self.assertEqual(self.run_cli("list").stdout, "[ ] 1 Buy milk\n")
+
+    def test_loads_file_without_due(self):
+        with open(self.env["TASKS_FILE"], "w") as f:
+            json.dump([{"id": 1, "title": "Buy milk", "done": False, "tags": ["home"]}], f)
+        self.assertEqual(self.run_cli("list").stdout, "[ ] 1 Buy milk #home\n")
+        self.run_cli("done", "1")
+        self.assertEqual(self.run_cli("list", "--all").stdout, "[x] 1 Buy milk #home\n")
+        with open(self.env["TASKS_FILE"]) as f:
+            self.assertEqual(json.load(f), [{"id": 1, "title": "Buy milk", "done": True, "tags": ["home"]}])
 
