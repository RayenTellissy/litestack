--- a/tasks/store.py
+++ b/tasks/store.py
@@ -1,6 +1,7 @@
 import json
 import os
 from dataclasses import asdict
+from datetime import date
 
 from .model import Task
 
@@ -12,11 +13,24 @@ def path():
 def load():
     try:
         with open(path()) as f:
-            return [Task(**raw) for raw in json.load(f)]
+            return [_decode(raw) for raw in json.load(f)]
     except FileNotFoundError:
         return []
 
 
 def save(tasks):
     with open(path(), "w") as f:
-        json.dump([asdict(task) for task in tasks], f, indent=2)
+        json.dump([_encode(task) for task in tasks], f, indent=2)
+
+
+def _decode(raw):
+    due = raw.pop("due", None)
+    return Task(**raw, due=None if due is None else date.fromisoformat(due))
+
+
+def _encode(task):
+    raw = asdict(task)
+    due = raw.pop("due")
+    if due is not None:
+        raw["due"] = due.isoformat()
+    return raw
